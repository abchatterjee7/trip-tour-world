GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL_ID = "openai/gpt-oss-20b"
AVIATIONSTACK_API_KEY = "your_aviationstack_api_key_here"
OPENWEATHER_API_KEY = "your_openweather_api_key_here"
DEFAULT_ORIGIN_IATA="DEL"
TAVILY_API_KEY = "your_tavily_api_key_here"
DATABASE_URL = "your_neondb_postgresql_db_url_here"
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="TripTourWorld"

# ---------------------------------------------------------------------------
# Optional hardening / tuning (safe defaults are built in; remove or edit freely)
# ---------------------------------------------------------------------------
# Protects /api/** with an X-API-Key header. LEAVE EMPTY ONLY FOR LOCAL DEV.
# Generate one:  openssl rand -hex 24
APP_API_KEY = ""
# Comma-separated browser origins allowed to call the API cross-site (empty = same-origin only)
ALLOWED_ORIGINS = ""
# Max write requests (plan / review / eval) per client IP per minute
RATE_LIMIT_PER_MINUTE = "30"
# How many times a reviewer may request changes before the plan is finalized
MAX_REVISIONS = "2"
